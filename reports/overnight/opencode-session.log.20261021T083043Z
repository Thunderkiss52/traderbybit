            $averageLoss = $this->decimal->divide(
                $this->decimal->add($this->decimal->multiply($averageLoss, $period - 1), $loss),
                $period,
            );
            $result[$index] = $this->rsi($averageGain, $averageLoss);
        }

        return $result;

#!/usr/bin/env bash
# File-based phase checkpoint (VECTOR v1.1 §0.6). No git commit/reset/clean.
set -uo pipefail
REPO=/home/thunder/work/traderbybit
PHASE="${1:-phase}"
TS=$(date -u +%Y%m%dT%H%M%SZ)
DIR="$REPO/reports/overnight/checkpoints/${PHASE}_${TS}"
mkdir -p "$DIR"
cd "$REPO" || exit 1

git diff --binary HEAD -- . ':(exclude)reports/overnight' > "$DIR/diff.patch" 2>"$DIR/diff.err"
git status --short > "$DIR/status.txt"
git diff --stat HEAD -- . ':(exclude)reports/overnight' > "$DIR/diffstat.txt"
git ls-files --others --exclude-standard | grep -v '^reports/overnight/' > "$DIR/untracked.txt" || true

tar --exclude='./.git' --exclude='./.env' --exclude='./.env.*' --exclude='./vendor' \
    --exclude='./node_modules' --exclude='./frontend/node_modules' --exclude='./frontend/dist' \
    --exclude='./reports/overnight' --exclude='./storage' --exclude='./bootstrap/cache' \
    --exclude='./econom*' --exclude='./.econom*' --exclude='./research-go/bin' \
    -czf "$DIR/snapshot.tar.gz" . 2>"$DIR/tar.err"

if tar -tzf "$DIR/snapshot.tar.gz" > /dev/null 2>&1; then
    echo "archive_ok=1" > "$DIR/integrity.txt"
else
    echo "archive_ok=0" > "$DIR/integrity.txt"
fi
{
    echo "phase=${PHASE}"
    echo "utc=${TS}"
    echo "git_head=$(git rev-parse HEAD)"
    echo "snapshot=$(sha256sum "$DIR/snapshot.tar.gz" | cut -d' ' -f1)"
    echo "snapshot_bytes=$(stat -c%s "$DIR/snapshot.tar.gz")"
    echo "diff_sha256=$(sha256sum "$DIR/diff.patch" | cut -d' ' -f1)"
    echo "diff_bytes=$(stat -c%s "$DIR/diff.patch")"
} > "$DIR/sha256.txt"

echo "CHECKPOINT_DIR=$DIR"
cat "$DIR/sha256.txt"
cat "$DIR/integrity.txt"

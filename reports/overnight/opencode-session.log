+    $service->activateKillSwitch('OPERATOR_STOP');
+
+    $release = $service->releaseKillSwitch('AUTHORISED');
+
+    self::assertSame('RELEASE_REFUSED', $release['status']);
+    self::assertTrue($service->killSwitchActive());
+}

APP_NAME="Bybit Signals"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bybit_signals
DB_USERNAME=bybit_signals
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

UI_BACKTEST_TOKEN=
RESEARCH_AUTO_BOOTSTRAP=true
RESEARCH_AUTO_EVALUATION_DAYS=14
RESEARCH_AUTO_PATTERN_MINIMUM_DECISIONS=700
RESEARCH_AUTO_PATTERN_RETRY_NEW_DECISIONS=120

VECTOR_BINANCE_PAPER_PROVISIONING_APPROVED=true
VECTOR_BINANCE_PAPER_EXECUTION_APPROVED=false
VECTOR_BINANCE_PAPER_TAKER_RATE=0.0005
VECTOR_BINANCE_PAPER_SLIPPAGE_RATE=0.0002
VECTOR_BINANCE_RESEARCH_CYCLE_ENABLED=true

# Optional strategy authoring only; owner consent is required per request.
STRATEGY_AUTHORING_HOSTED_ENABLED=false
STRATEGY_AUTHORING_HOSTED_DRIVER=gateway
STRATEGY_AUTHORING_HOSTED_URL=
STRATEGY_AUTHORING_HOSTED_MODEL=
STRATEGY_AUTHORING_HOSTED_TOKEN=

COMPOSE_PROJECT_NAME=bybit-signals
ENV_FILE=.env.production
IMAGE_TAG=latest
APP_IMAGE=ghcr.io/OWNER/REPOSITORY/app
WEB_IMAGE=ghcr.io/OWNER/REPOSITORY/web
RESEARCH_WORKER_IMAGE=ghcr.io/OWNER/REPOSITORY/research-worker
DEPLOY_MODE=pull
MIN_FREE_DISK_GB=10

APP_NAME="Bybit Signals"
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=https://signals.example.com
APP_DEBUG=false
LOG_LEVEL=info

POSTGRES_DB=bybit_signals
POSTGRES_USER=bybit_signals
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD

UI_BASIC_AUTH_USER=research
UI_BASIC_AUTH_PASSWORD=REPLACE_WITH_LONG_RANDOM_HTTP_PASSWORD
# Optional safer transport for passwords containing shell-sensitive characters.
# When set, this decoded value takes precedence over UI_BASIC_AUTH_PASSWORD.
UI_BASIC_AUTH_PASSWORD_B64=
UI_BACKTEST_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_TOKEN
RESEARCH_AUTO_BOOTSTRAP=true
RESEARCH_AUTO_EVALUATION_DAYS=14
RESEARCH_AUTO_PATTERN_MINIMUM_DECISIONS=700
RESEARCH_AUTO_PATTERN_RETRY_NEW_DECISIONS=120
CORS_ALLOWED_ORIGINS=https://signals.example.com

WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
EXTERNAL_PROXY_NETWORK=

APP_UID=10001
APP_GID=10001
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
WEB_MEMORY_LIMIT=128m
WEB_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
POSTGRES_SHM_SIZE=256m
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=0.5
QUEUE_MEMORY_LIMIT=512m
QUEUE_CPU_LIMIT=1.0
QUEUE_WORKER_MEMORY_MB=384
SCHEDULER_MEMORY_LIMIT=256m
SCHEDULER_CPU_LIMIT=0.25
MARKET_WS_MEMORY_LIMIT=256m
MARKET_WS_CPU_LIMIT=0.5
BACKTEST_MEMORY_LIMIT=2g
BACKTEST_CPU_LIMIT=2.0
BACKTEST_WORKER_MEMORY_MB=1536

BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_HTTP_TIMEOUT=10
BYBIT_HTTP_CONNECT_TIMEOUT=3
BYBIT_HTTP_MAX_RETRIES=4
BYBIT_BACKOFF_BASE_MS=250
BYBIT_BACKOFF_MAX_MS=5000
BYBIT_WS_HEARTBEAT_SECONDS=20
BYBIT_WS_RECEIVE_TIMEOUT=1
BYBIT_WS_RECONNECT_MAX_SECONDS=30
BYBIT_WS_RECOVERY_LOOKBACK_MINUTES=180
MARKET_DATA_BACKFILL_PASSES=2
MARKET_DATA_LOCK_SECONDS=900
MARKET_DATA_FRESHNESS_MULTIPLIER=3
MARKET_DATA_INITIAL_HISTORY_DAYS=30
# 0 disables deletion. Historical candles are never pruned automatically.
MARKET_DATA_RETENTION_DAYS=0

BACKUP_DIR=./backups/bybit-signals
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=7
# Optional mounted/off-host path. A verified copy and checksum are written here.
BACKUP_EXTERNAL_DIR=

# Binance Public Market Data & Isolated PAPER Trading (USD(S)-M Futures)
# Strictly simulated paper trading; no trade credentials or live order endpoints exist.
#
# VECTOR_BINANCE_PAPER_PROVISIONING_APPROVED: Set true to allow provisioning of the 13 Binance PAPER accounts.
VECTOR_BINANCE_PAPER_PROVISIONING_APPROVED=true
#
# VECTOR_BINANCE_PAPER_EXECUTION_APPROVED: Master gate for simulated order executions on Binance PAPER accounts.
# Defaults to false. When false, eligible accounts can be ACTIVATED, but virtual order execution remains blocked.
VECTOR_BINANCE_PAPER_EXECUTION_APPROVED=false
#
# VECTOR_BINANCE_PAPER_TAKER_RATE: Standard taker fee fraction for Binance USD(S)-M Futures.
# Source: Binance Official Fee Schedule (fapi.binance.com), VIP 0 (Regular User) tier.
# Units: decimal fraction (0.0005 = 0.05% = 5 bps). Version: binance-usdm-perpetual-2026.1.
VECTOR_BINANCE_PAPER_TAKER_RATE=0.0005
#
# VECTOR_BINANCE_PAPER_SLIPPAGE_RATE: Conservative top-of-book slippage fraction for BTCUSDT/ETHUSDT linear contracts.
# Source: Orderbook top-of-book empirical depth analysis (2 bps per fill).
# Units: decimal fraction (0.0002 = 0.02% = 2 bps). Version: binance-usdm-perpetual-2026.1.
VECTOR_BINANCE_PAPER_SLIPPAGE_RATE=0.0002
#
# VECTOR_BINANCE_RESEARCH_CYCLE_ENABLED: Enable closed-candle research cycle schedule for Binance.
VECTOR_BINANCE_RESEARCH_CYCLE_ENABLED=true
